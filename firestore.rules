rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read and write access for shipment tracking telemetry
    match /shipments/{shipmentId} {
      allow read, write: if true;
    }
  }
}
